# Make the engines block in package.json a hard failure rather than an
# EBADENGINE warning. Without this, an unsupported Node or npm only prints
# warnings that scroll past in a build log -- which is exactly how the
# production image sat on node:18.20-alpine long after the toolchain had
# moved to Node 20.19+/22.12+, and surfaced instead as an unrelated-looking
# "Missing: unplugin@3.3.0 from lock file" error from `npm ci`.
#
# The npm floor is separate from the Node one and is not redundant: npm 10.x
# computes a different ideal tree than npm 11 recorded in package-lock.json
# and rejects the lock outright. That is a property of the lock, not of the
# lockfileVersion -- converting the lock to v3 does not help, verified
# against npm 10.8.2 and 10.9.4. Node 22 LTS bundles npm 10.9.x, so a Node
# 22 install needs its npm upgraded even though the Node range allows it.
engine-strict=true
