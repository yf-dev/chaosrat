#!/usr/bin/env bash

# Husky's own shim (.husky/_/h) always runs this file as `sh -e "$s"` — it
# never honors the shebang above, so without this re-exec we'd silently run
# under dash/POSIX sh instead of bash and lose `set -o pipefail`/`[[ ]]`
# below (dash rejects both). Re-exec under real bash before using any
# bash-only syntax.
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -o errexit
set -o nounset
set -o pipefail

if [[ "${TRACE-0}" == "1" ]]; then
  set -o xtrace
fi

# Git invokes hooks with the working directory set to the repo root
# (/project), but this is a subdirectory package (/project/app). cd relative
# to this script's own location so the hook works from any clone path.
cd "$(dirname "$0")/.."

echo "==> [pre-commit] running lint-staged..."
npx lint-staged

# vue-tsc is a whole-project check — it has no staged-only mode, and a type
# error is by nature cross-file (a change to one file breaks another), so
# scoping it to the staged set would defeat the point. Same working-tree
# caveat as the test suite below.
echo "==> [pre-commit] running typecheck..."
npm run typecheck

# Runs unconditionally rather than only when a DESIGN.md or main.css is
# staged -- one of the failure modes this catches is a theme directory that
# has NO DESIGN.md at all, and a staged-path filter can never match an
# absence. It's also whole-project for the same cross-file reason as
# typecheck above: a theme spec's restated contract values can drift from
# main.css without either file being in this commit's diff. Fast and fully
# local (a pinned devDependency, not `npx`), so there's no cost worth an
# escape hatch for.
#
# The two accepted contrast-ratio warnings (cute's nickname strip, video-
# master's header label) do NOT block this -- only error findings and
# contract mismatches do. Don't "fix" those warnings thinking they're
# breaking commits; they're deliberately-accepted design decisions recorded
# in the theme's own DESIGN.md.
echo "==> [pre-commit] running design:check..."
npm run design:check

# NOTE: this runs the test suite against the current working tree, not the
# strict staged-only snapshot lint-staged normally provides. That's a
# deliberate, accepted tradeoff (running vitest against a synthetic
# staged-only checkout would be significantly more complex), not an oversight.
echo "==> [pre-commit] running test suite..."
npm run test

# The e2e suite is what stops an unintended *visual* change from shipping:
# vitest never applies a theme's scoped CSS (vue-test-utils does not inject
# SFC <style> blocks at all), so a theme can be restyled arbitrarily with the
# whole unit suite still green. Playwright renders the real overlay in a real
# browser and diffs both a pixel screenshot and a computed-style fingerprint
# per theme.
#
# This runs unconditionally rather than only when a UI-shaped path is staged,
# for the same reason typecheck above is whole-project: rendering is
# cross-file. A change to lib/utils.ts's messageHtml(), to a shared token in
# assets/css/main.css, or to ChatOverlay.vue's theme switch all change what a
# theme looks like without touching components/themes/. Any staged-path filter
# would have to enumerate those, and that enumeration rots the moment someone
# adds a file. The whole suite runs in well under a minute against an already
# warm dev server, so there is no tradeoff worth buying with a hole.
#
# Playwright's `webServer` starts `npm run dev` itself when nothing is on
# :3000 and reuses an already-running dev server otherwise, so this needs no
# setup either way -- the first commit of a session just pays the Nuxt boot.
#
# Escape hatch: `SKIP_E2E=1 git commit ...` when you knowingly need to skip
# (e.g. no browser available). Snapshots are refreshed with
# `npm run test:e2e:update` -- review that diff, never re-baseline blindly.
if [[ "${SKIP_E2E-0}" == "1" ]]; then
  echo "==> [pre-commit] SKIP_E2E=1 set, skipping e2e/visual suite" >&2
else
  echo "==> [pre-commit] running e2e + visual snapshot suite..."
  npm run test:e2e
fi
