{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    // Nuxt 4 enables this by default. Preserve this project's prior Nuxt 3
    // typecheck behavior during the security upgrade.
    "noUncheckedIndexedAccess": false,
    // vitest runs with `globals: true` (see vitest.config.ts), so `describe`,
    // `it`, `expect` and `vi` are ambient in test files. Nuxt's generated
    // tsconfig sets `"types": []`, which leaves the editor and a raw `tsc`
    // reporting them as undefined names.
    "types": ["vitest/globals"]
  }
}
