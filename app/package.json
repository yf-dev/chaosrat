{
  "name": "chaosrat",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "nuxt cleanup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky app/.husky"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.1",
    "@tabler/icons-vue": "^2.47.0",
    "@vueuse/core": "^10.8.0",
    "broadcast-channel": "^7.2.0",
    "chota": "^0.9.2",
    "events": "^3.3.0",
    "js-base64": "^3.7.7",
    "nuxt": "^3.21.9",
    "pinia": "^2.1.7",
    "pretendard": "^1.3.9",
    "sanitize-html": "^2.12.1",
    "socket.io-client": "2.0.3",
    "strict-event-emitter-types": "^2.0.0",
    "tmi-utils": "^1.0.1",
    "tmi.js": "^1.8.5",
    "vue": "^3.4.19",
    "vue-router": "^4.3.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/sanitize-html": "^2.11.0",
    "@types/socket.io-client": "1.4.36",
    "@types/tmi.js": "^1.8.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "10.8.0",
    "happy-dom": "^20.11.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "nuxt-gtag": "^2.0.5",
    "prettier": "3.9.6",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
