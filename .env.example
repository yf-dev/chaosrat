# Copy this file to `.env` (next to docker-compose.yml) and fill in real
# values. `.env` is gitignored (see .gitignore) so real credentials never get
# committed; docker compose loads `.env` automatically.

NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=
NUXT_CHZZK_CLIENT_ID=
NUXT_CHZZK_CLIENT_SECRET=
NUXT_PUBLIC_BASE_URL=http://localhost:3000
NUXT_PUBLIC_GTAG_ID=
